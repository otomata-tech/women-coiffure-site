---
// Sur-titre en capitales espacées au-dessus d'un titre (« Réservation 24h/24 »),
// en serif. `tone` = surface qui le porte : encre sur fond clair, clair sur
// bande sombre.
interface Props {
  tone?: 'default' | 'inverse';
  class?: string;
}
const { tone = 'default', class: cls = '' } = Astro.props;
const color = tone === 'inverse' ? 'text-inverse-fg' : 'text-fg';
---

<span
  class={`block font-display text-[.85rem] font-semibold tracking-[.12em] uppercase lining-nums xs:text-[.95rem] xs:tracking-[.2em] ${color} ${cls}`}
>
  <slot />
</span>
