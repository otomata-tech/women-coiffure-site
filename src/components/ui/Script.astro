---
// Accent manuscrit rose (« dans chaque détail », « By Nath », « Suivez-nous… »).
// Taille et marges au call-site : l'accent se pose dans un titre, une légende
// ou seul.
interface Props {
  as?: 'span' | 'p';
  class?: string;
}
const { as: Tag = 'span', class: cls = '' } = Astro.props;
---

<Tag class={`font-script leading-none font-normal tracking-normal normal-case text-pink ${cls}`}>
  <slot />
</Tag>
