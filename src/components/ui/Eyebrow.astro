---
// Sur-titre en capitales espacées au-dessus d'un titre (« Réservation 24h/24 »),
// en Manrope comme dans la maquette de Nathalie. `tone` = surface qui le porte :
// or sur fond clair, champagne sur bande sombre.
interface Props {
  tone?: 'default' | 'inverse';
  class?: string;
}
const { tone = 'default', class: cls = '' } = Astro.props;
const color = tone === 'inverse' ? 'text-champagne' : 'text-accent';
---

<span class={`block text-[.72rem] font-bold tracking-[.22em] uppercase ${color} ${cls}`}>
  <slot />
</span>
