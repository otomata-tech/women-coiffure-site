---
import type { CollectionEntry } from 'astro:content';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';

// Encart « Nouvelle cliente » : consultation avant le premier rendez-vous.
interface Props {
  block: CollectionEntry<'accueil'>['data']['newClient'];
}
const { block } = Astro.props;
---

<div
  class="grid grid-cols-1 items-center gap-7 rounded-3xl bg-soft px-6 py-7 md:grid-cols-[1fr_auto] md:p-10"
>
  <div>
    <Eyebrow>{block.eyebrow}</Eyebrow>
    <h2 class="mt-2.5 text-[clamp(1.9rem,4vw,2.7rem)]">{block.title}</h2>
    <p class="mt-2.5 max-w-[56ch] text-muted">{block.text}</p>
  </div>
  <Button href={block.cta.href}>
    {block.cta.label}
  </Button>
</div>
