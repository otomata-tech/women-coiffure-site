---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Icon from '@/components/ui/Icon.astro';

// Haut de page : titre (fin en italique or) et boutons RDV/appel à gauche,
// portrait en arche à droite avec son étiquette, bandeau de quatre chiffres clés.
// Bloc isolé à dessein (identité visuelle en cours de recherche) : le remplacer
// ne touche que ce composant et les blocs `hero`/`stats` de accueil.md.
type Accueil = CollectionEntry<'accueil'>['data'];
interface Props {
  hero: Accueil['hero'];
  stats: Accueil['stats'];
  bookingHref: string;
  phone: { display: string; href: string };
}
const { hero, stats, bookingHref, phone } = Astro.props;
---

<Container class="pt-10 pb-16">
  <div
    class="grid grid-cols-1 items-center gap-8 tab:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] tab:gap-14"
  >
    <div>
      <Eyebrow>{hero.eyebrow}</Eyebrow>
      <h1 class="mt-4.5 mb-5.5 text-[clamp(2.6rem,6vw,4.6rem)] leading-[1.02]">
        {hero.title}
        <em class="block text-accent italic">{hero.titleEmphasis}</em>
      </h1>
      <p class="mb-7.5 max-w-[42ch] text-[clamp(1.08rem,2.2vw,1.25rem)]">{hero.lead}</p>
      <div class="flex flex-wrap gap-3">
        <Button href={bookingHref}>{hero.ctaLabel}</Button>
        <Button href={phone.href} variant="outline">
          <Icon name="phone" size={16} />
          {phone.display}
        </Button>
      </div>
    </div>
    <figure class="relative m-0">
      <Image
        src={hero.portrait}
        alt={hero.portraitAlt}
        widths={[600, 1200]}
        sizes="(min-width: 1120px) 500px, (min-width: 860px) 45vw, 100vw"
        class="aspect-square h-auto w-full rounded-[220px_220px_22px_22px] object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption
        class="absolute bottom-7 left-3 max-w-[calc(100%-1.5rem)] rounded-tile bg-bg px-4.5 py-3 text-[.82rem] leading-snug font-semibold shadow-tag tab:-left-4.5"
      >
        {hero.caption}
      </figcaption>
    </figure>
  </div>
  <div
    class="mt-10 grid grid-cols-2 border-y border-border md:mt-14 md:grid-cols-4"
    aria-label="En quelques chiffres"
  >
    {
      stats.map((s, i) => (
        <div
          class:list={[
            'px-4.5 py-5.5 text-center',
            i % 2 === 1 && 'border-l border-border',
            i === 2 && 'md:border-l md:border-border',
            i >= 2 && 'border-t border-border md:border-t-0',
          ]}
        >
          <b class="block font-display text-[1.5rem] leading-[1.1] font-medium lining-nums xs:text-[2rem]">
            {s.value}
          </b>
          <span class="text-[.8rem] text-muted">{s.label}</span>
        </div>
      ))
    }
  </div>
</Container>
