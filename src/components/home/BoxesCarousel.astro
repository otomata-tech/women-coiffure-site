---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';

// Carrousel des coffrets : défilement aimanté natif (glisser au doigt, 1 slide
// sur mobile, 2 puis 3 en bureau) ; le <script> ajoute la lecture automatique
// (4 s, en pause au survol, au toucher et au focus, coupée si l'utilisateur
// réduit les animations), les flèches et les points.
interface Props {
  block: CollectionEntry<'accueil'>['data']['boxes'];
}
const { block } = Astro.props;
const total = block.items.length;
---

<div data-carousel class="grid grid-cols-1 gap-5" aria-roledescription="carrousel" role="region" aria-label={block.title}>
  <div class="relative">
    <ul
      data-track
      class="relative -mx-5 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 pb-1 [scrollbar-width:none] md:mx-0 md:scroll-px-0 md:px-0 [&::-webkit-scrollbar]:hidden"
    >
      {
        block.items.map((box, i) => (
          <li
            data-slide
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} / ${total}`}
            class="flex flex-[0_0_85%] snap-start flex-col overflow-hidden rounded-card border border-border bg-surface md:flex-[0_0_calc((100%-1rem)/2)] lg:flex-[0_0_calc((100%-2rem)/3)]"
          >
            <Image
              src={box.photo}
              alt={`${box.name} : ${box.contents}`}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 345px, (min-width: 768px) 50vw, 85vw"
              loading={i < 3 ? 'eager' : 'lazy'}
              class="aspect-4/3 h-auto w-full bg-surface object-contain"
            />
            <div class="flex flex-1 flex-col gap-2 border-t border-border p-5">
              <h3 class="text-[1.6rem] leading-tight">{box.name}</h3>
              <p class="m-0 flex-1 text-[.88rem] leading-normal text-muted">{box.contents}</p>
              <p class="m-0 font-display text-[1.7rem] font-semibold text-accent tabular-nums">
                {box.price}&nbsp;€
              </p>
            </div>
          </li>
        ))
      }
    </ul>
    <button
      type="button"
      data-prev
      aria-label="Box précédente"
      class="absolute top-[calc(50%-4rem)] left-1 grid size-11 place-items-center rounded-full border border-border bg-surface/90 text-fg shadow-tag transition hover:bg-inverse hover:text-inverse-fg motion-reduce:transition-none md:-left-5"
    >
      <Icon name="arrow-right" size={18} class="rotate-180" />
    </button>
    <button
      type="button"
      data-next
      aria-label="Box suivante"
      class="absolute top-[calc(50%-4rem)] right-1 grid size-11 place-items-center rounded-full border border-border bg-surface/90 text-fg shadow-tag transition hover:bg-inverse hover:text-inverse-fg motion-reduce:transition-none md:-right-5"
    >
      <Icon name="arrow-right" size={18} />
    </button>
  </div>

  <div class="flex flex-wrap justify-center">
    {
      block.items.map((box, i) => (
        <button
          type="button"
          data-dot
          aria-label={`${box.name} (${i + 1} / ${total})`}
          class="group grid size-6 place-items-center"
        >
          <span class="block h-2 w-2 rounded-full bg-border transition-all group-hover:bg-champagne group-aria-[current=true]:w-5 group-aria-[current=true]:bg-fg motion-reduce:transition-none" />
        </button>
      ))
    }
  </div>

  <div class="grid justify-items-center gap-3 text-center">
    <Button href={block.cta.href}>{block.cta.label}</Button>
    <p class="m-0 text-[.88rem] text-muted">{block.note}</p>
  </div>
</div>

<script>
  const DELAY = 4000;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];

    // Écart entre deux slides et dernière position atteignable (plusieurs
    // slides visibles à la fois en bureau : les derniers points sont masqués).
    const step = () => slides[1].offsetLeft - slides[0].offsetLeft;
    const last = () => Math.max(0, Math.round((track.scrollWidth - track.clientWidth) / step()));
    const current = () => Math.round(track.scrollLeft / step());

    const go = (i: number) => {
      const n = last();
      const target = i > n ? 0 : i < 0 ? n : i;
      track.scrollTo({ left: target * step(), behavior: reduce.matches ? 'auto' : 'smooth' });
    };

    const update = () => {
      const n = last();
      const idx = Math.min(current(), n);
      dots.forEach((dot, k) => {
        dot.hidden = k > n;
        if (k === idx) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    // Lecture automatique : en pause tant que la souris, le doigt ou le focus
    // est dans le carrousel, ou qu'il est hors de l'écran.
    let hovered = false;
    let visible = false;
    let timer: number | undefined;
    const restart = () => {
      window.clearInterval(timer);
      if (reduce.matches) return;
      timer = window.setInterval(() => {
        if (!hovered && visible && !document.hidden) go(current() + 1);
      }, DELAY);
    };

    let frame = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    });
    window.addEventListener('resize', update);

    root.querySelector('[data-prev]')!.addEventListener('click', () => {
      go(current() - 1);
      restart();
    });
    root.querySelector('[data-next]')!.addEventListener('click', () => {
      go(current() + 1);
      restart();
    });
    dots.forEach((dot, k) =>
      dot.addEventListener('click', () => {
        go(k);
        restart();
      }),
    );

    root.addEventListener('pointerenter', () => (hovered = true));
    root.addEventListener('pointerleave', () => (hovered = false));
    root.addEventListener('touchstart', () => (hovered = true), { passive: true });
    root.addEventListener('touchend', () => {
      hovered = false;
      restart();
    });
    root.addEventListener('focusin', () => (hovered = true));
    root.addEventListener('focusout', () => (hovered = false));

    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(root);
    reduce.addEventListener('change', restart);

    update();
    restart();
  }
</script>
