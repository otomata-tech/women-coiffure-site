---
import { getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import Hero from '@/components/home/Hero.astro';
import SalonCard from '@/components/home/SalonCard.astro';
import FounderBio from '@/components/home/FounderBio.astro';
import NewClient from '@/components/home/NewClient.astro';
import SalonGallery from '@/components/home/SalonGallery.astro';
import EventsSection from '@/components/home/EventsSection.astro';
import RealisationsList from '@/components/home/RealisationsList.astro';
import InstagramBand from '@/components/home/InstagramBand.astro';
import NewsList from '@/components/home/NewsList.astro';
import ShopBlock from '@/components/home/ShopBlock.astro';
import BoxesCarousel from '@/components/home/BoxesCarousel.astro';
import { SITE } from '@/lib/site';
import { getSalons, salonJsonLd } from '@/lib/salons';
import { getActus } from '@/lib/actus';
import { getRealisations } from '@/lib/realisations';

// Accueil : page sur mesure qui ASSEMBLE le contenu, sans texte propre.
// Textes : src/content/accueil/accueil.md ; salons : src/content/salons/ ;
// actus : src/content/actus/ ; téléphone, Instagram, menu : settings/site.json.
const accueil = await getEntry('accueil', 'accueil');
if (!accueil) throw new Error('src/content/accueil/accueil.md introuvable.');
if (!SITE.phone) throw new Error('site.json : contact.phone est requis sur l’accueil.');
const page = accueil.data;
const phone = SITE.phone;
const salons = await getSalons();
const actus = await getActus();
const realisations = await getRealisations();
const salonNodes = await Promise.all(salons.map(salonJsonLd));

const meta = { title: page.title, description: SITE.description };
---

<BaseLayout meta={meta} type="website" updatedDate={page.updatedDate} graph={salonNodes}>
  <Hero hero={page.hero} stats={page.stats} bookingHref="#salons" phone={phone} />

  <Section id="boxes">
    <Container>
      <SectionHead eyebrow={page.boxes.eyebrow} title={page.boxes.title}>
        {page.boxes.intro}
      </SectionHead>
      <BoxesCarousel block={page.boxes} />
    </Container>
  </Section>

  <Section id="salons">
    <Container>
      <SectionHead eyebrow={page.salons.eyebrow} title={page.salons.title}>
        {page.salons.intro}{' '}
        {SITE.contact?.phoneNote}{'\u00a0'}:
        <a class="link-line font-bold whitespace-nowrap text-fg tabular-nums" href={phone.href}
          >{phone.display}</a
        >
      </SectionHead>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(290px,1fr))] gap-5.5">
        {salons.map((salon) => <SalonCard salon={salon} />)}
      </div>
      <p class="mt-8 max-w-[48ch] font-display text-[1.45rem] leading-[1.35] italic">
        {page.salons.teamNote}
      </p>
    </Container>
  </Section>

  <Section id="fondatrice">
    <Container>
      <FounderBio founder={page.founder} />
    </Container>
  </Section>

  <Container>
    <NewClient block={page.newClient} phone={phone} />
  </Container>

  <Section id="visite" class="mt-18">
    <Container>
      <SectionHead eyebrow={page.visit.eyebrow} title={page.visit.title}>
        {page.visit.intro}
      </SectionHead>
      {salons.map((salon, i) => <SalonGallery salon={salon} first={i === 0} />)}
    </Container>
  </Section>

  {
    realisations.length > 0 && (
      <Section id="realisations" class="mt-18">
        <Container>
          <SectionHead eyebrow={page.realisations.eyebrow} title={page.realisations.title}>
            {page.realisations.intro}
          </SectionHead>
          <RealisationsList items={realisations} />
        </Container>
      </Section>
    )
  }

  <Section id="evenementiel" class="mt-18">
    <Container>
      <EventsSection block={page.events} phone={phone} />
    </Container>
  </Section>

  <Container>
    <InstagramBand block={page.instagram} accounts={SITE.social.instagram} />
  </Container>

  <Section id="actu" class="mt-18">
    <Container>
      <SectionHead eyebrow={page.news.eyebrow} title={page.news.title}>
        {page.news.intro}
      </SectionHead>
      <NewsList actus={actus} />
    </Container>
  </Section>

  <Container>
    <div id="boutique">
      <ShopBlock block={page.shop} />
    </div>
  </Container>
</BaseLayout>
