---
interface Props {
  href?: string;
  /** primary = noir plein ; outline = contour (rempli au survol) ; accent = plein rose. */
  variant?: 'primary' | 'outline' | 'accent';
  /** Surface qui PORTE le bouton : `inverse` = bande sombre (tokens --color-inverse*). */
  tone?: 'default' | 'inverse';
  /** bar = bouton étiré de la barre fixe mobile (padding latéral réduit). */
  size?: 'md' | 'sm' | 'bar';
  type?: 'button' | 'submit';
  class?: string;
}
const {
  href,
  variant = 'primary',
  tone = 'default',
  size = 'md',
  type = 'button',
  class: cls = '',
} = Astro.props;

// Pilule de la charte : contour 1,5px, léger soulèvement au survol (coupé si
// l'utilisateur réduit les animations). Focus : anneau rose global (global.css).
const base =
  'inline-flex items-center justify-center gap-2.5 whitespace-nowrap rounded-full border-[1.5px] font-bold transition duration-150 hover:-translate-y-0.5 disabled:opacity-50 motion-reduce:transition-none motion-reduce:hover:translate-y-0';

const sizes = {
  md: 'px-6.5 py-3.75 text-[.95rem]',
  sm: 'px-4.5 py-2.5 text-[.85rem]',
  bar: 'flex-1 px-2.5 py-3.5 text-[.95rem]',
} as const;

// Ratios (WCAG, seuil 4,5:1 pour le libellé) :
//   primary        inverse-fg / inverse 17,4:1
//   outline        inverse / bg 19,6:1 ; au survol inverse-fg / inverse
//   accent         accent-fg / accent 5,6:1
//   inverse/outline inverse-fg / inverse 17,4:1
const styles = {
  default: {
    primary: 'border-inverse bg-inverse text-inverse-fg',
    outline: 'border-inverse bg-transparent text-inverse hover:bg-inverse hover:text-inverse-fg',
    accent: 'border-accent bg-accent text-accent-fg',
  },
  inverse: {
    primary: 'border-inverse-fg bg-inverse-fg text-inverse',
    outline:
      'border-inverse-fg bg-transparent text-inverse-fg hover:bg-inverse-fg hover:text-inverse',
    accent: 'border-accent bg-accent text-accent-fg',
  },
} as const;

// Lien vers un autre site (Planity, Instagram) : ouvert dans un nouvel onglet.
const external = href?.startsWith('http') ?? false;
const classes = `${base} ${sizes[size]} ${styles[tone][variant]} ${cls}`;
---

{
  href ? (
    <a
      href={href}
      class={classes}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener' : undefined}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
